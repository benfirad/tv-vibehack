<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendarOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E60A0C10"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header: Back, Month & Subtitle, Navigation Pills -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnCalClose"
                        style="@style/TopButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:gravity="center"
                        android:text="←"
                        android:textSize="18sp"
                        android:nextFocusLeft="@id/btnCalClose"
                        android:nextFocusRight="@id/btnCalPrev"
                        android:nextFocusUp="@id/btnCalClose"
                        android:nextFocusDown="@id/calGridTable" />

                    <TextView
                        android:id="@+id/tvCalMonthYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="-0.02"
                        android:text="October 2026"
                        android:textColor="#FFFFFFFF"
                        android:textSize="32sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCalSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="58dp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 400"
                    android:letterSpacing="0.08"
                    android:text="DOMINGO, 18 OCTUBRE — Sin eventos programados para hoy"
                    android:textAllCaps="true"
                    android:textColor="#38BDF8"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCalPrev"
                    style="@style/TopButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textSize="22sp"
                    android:nextFocusLeft="@id/btnCalClose"
                    android:nextFocusRight="@id/btnCalToday"
                    android:nextFocusUp="@id/btnCalPrev"
                    android:nextFocusDown="@id/calGridTable" />

                <TextView
                    android:id="@+id/btnCalToday"
                    style="@style/TopButton"
                    android:text="Hoy"
                    android:nextFocusLeft="@id/btnCalPrev"
                    android:nextFocusRight="@id/btnCalNext"
                    android:nextFocusUp="@id/btnCalToday"
                    android:nextFocusDown="@id/calGridTable" />

                <TextView
                    android:id="@+id/btnCalNext"
                    style="@style/TopButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="22sp"
                    android:nextFocusLeft="@id/btnCalToday"
                    android:nextFocusRight="@id/btnCalNext"
                    android:nextFocusUp="@id/btnCalNext"
                    android:nextFocusDown="@id/calGridTable" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Two-column Layout: Month Grid on left, RM-OS Agenda on right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7"
                android:orientation="vertical">

                <!-- Days of Week Header -->
                <LinearLayout
                    android:id="@+id/calWeekDays"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:orientation="horizontal">

                    <TextView style="@style/CalDayHeader" android:text="DOM" />
                    <TextView style="@style/CalDayHeader" android:text="LUN" />
                    <TextView style="@style/CalDayHeader" android:text="MAR" />
                    <TextView style="@style/CalDayHeader" android:text="MIÉ" />
                    <TextView style="@style/CalDayHeader" android:text="JUE" />
                    <TextView style="@style/CalDayHeader" android:text="VIE" />
                    <TextView style="@style/CalDayHeader" android:text="SÁB" />
                </LinearLayout>

                <!-- Calendar Month Grid Container -->
                <TableLayout
                    android:id="@+id/calGridTable"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:stretchColumns="0,1,2,3,4,5,6" />
            </LinearLayout>

            <!-- Right Panel: RM-OS & DAAK Node Agenda -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:layout_marginStart="24dp"
                android:background="@drawable/setting_card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:text="📋 Agenda RM-OS y DAAK Node"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/outfit"
                    android:text="Google Calendar y Tareas daakREMEMBER"
                    android:textColor="#38BDF8"
                    android:textSize="12sp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/agendaList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Item 1: Honda Accord ITV Gelves (High Priority) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/pill_bg"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:text="🚗 27 Octubre 08:33 • Cita Previa ITV"
                                android:textColor="#F59E0B"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/outfit"
                                android:text="Honda Accord (8010 LBN) • Estación ITV Gelves (VEIASA) — en 9 días"
                                android:textColor="#D4D4D8"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Item 2: Sınav Derecho Privado (Yarın) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/pill_bg"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:text="📚 19 Octubre 13:40 • Examen Derecho Privado"
                                android:textColor="#EF4444"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/outfit"
                                android:text="Instituciones Básicas • Aula 44 — ¡Mañana!"
                                android:textColor="#D4D4D8"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Item 3: Contabilidad -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/pill_bg"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:text="📚 20 Octubre 13:30 • Examen Contabilidad"
                                android:textColor="#A855F7"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/outfit"
                                android:text="Fundamentos de Contabilidad • Aula 03 — en 2 días"
                                android:textColor="#D4D4D8"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Item 4: daakREMEMBER Tasks -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/pill_bg"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:text="⚡ Tareas daakREMEMBER"
                                android:textColor="#38BDF8"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/outfit"
                                android:text="• Redmono Catálogos de Feria (DR.BIO, Düzgünler)\n• Sincronización y Mantenimiento DAAK Node Hub"
                                android:textColor="#D4D4D8"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
