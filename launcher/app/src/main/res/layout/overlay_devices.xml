<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/devicesOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E60A0C10"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnDevClose"
                        style="@style/TopButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:gravity="center"
                        android:text="←"
                        android:textSize="18sp"
                        android:nextFocusLeft="@id/btnDevClose"
                        android:nextFocusRight="@id/tvDevRefresh"
                        android:nextFocusUp="@id/btnDevClose"
                        android:nextFocusDown="@id/btnSceneCinema" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="-0.02"
                        android:text="Dispositivos y Red RM-OS"
                        android:textColor="#FFFFFFFF"
                        android:textSize="32sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="58dp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 400"
                    android:letterSpacing="0.08"
                    android:text="DAAK FABRIC SEVILLA // NODOS ACTIVOS, ILUMINACIÓN HUE Y CONTROL DAAKNODE"
                    android:textAllCaps="true"
                    android:textColor="#34D399"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDevRefresh"
                style="@style/TopButton"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Actualizar"
                android:drawableStart="@drawable/ic_wifi"
                android:nextFocusLeft="@id/btnDevClose"
                android:nextFocusRight="@id/tvDevRefresh"
                android:nextFocusUp="@id/tvDevRefresh"
                android:nextFocusDown="@id/btnSceneReading" />
        </RelativeLayout>

        <!-- Devices & Hue Controls Scroll -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- DAAK NODE & PHILIPS HUE CARD -->
                <LinearLayout
                    android:id="@+id/cardHue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/device_card_bg"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Hue Header -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:letterSpacing="-0.01"
                                android:text="DAAK Smart Home • Philips Hue"
                                android:textColor="#FFFFFFFF"
                                android:textSize="19sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:background="#2634D399"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 500"
                                android:paddingStart="8dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="2dp"
                                android:text="Salón Chimenea"
                                android:textColor="#34D399"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/dotHueStatus"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="#34D399" />

                            <TextView
                                android:id="@+id/tvHueBridgeStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 400"
                                android:text="Puente: 192.168.236.62 • Conectado"
                                android:textColor="#A7F3D0"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Row 1: Sahneler (Scenes) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnSceneCinema"
                            style="@style/TopButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="🎬 Cine (%15)"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnSceneCinema"
                            android:nextFocusRight="@id/btnSceneNight"
                            android:nextFocusUp="@id/btnDevClose"
                            android:nextFocusDown="@id/btnHueMasterOn" />

                        <TextView
                            android:id="@+id/btnSceneNight"
                            style="@style/TopButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="🌙 Noche (%5)"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnSceneCinema"
                            android:nextFocusRight="@id/btnSceneReading"
                            android:nextFocusUp="@id/btnDevClose"
                            android:nextFocusDown="@id/btnHueMasterOff" />

                        <TextView
                            android:id="@+id/btnSceneReading"
                            style="@style/TopButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="📖 Lectura (%70)"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnSceneNight"
                            android:nextFocusRight="@id/btnSceneFull"
                            android:nextFocusUp="@id/tvDevRefresh"
                            android:nextFocusDown="@id/btnHueLight1" />

                        <TextView
                            android:id="@+id/btnSceneFull"
                            style="@style/TopButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="0dp"
                            android:layout_weight="1"
                            android:text="☀️ Total (%100)"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnSceneReading"
                            android:nextFocusRight="@id/btnSceneFull"
                            android:nextFocusUp="@id/tvDevRefresh"
                            android:nextFocusDown="@id/btnHueLight2" />
                    </LinearLayout>

                    <!-- Row 2: Master & Individual Controls -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnHueMasterOn"
                            style="@style/TopButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="💡 Encender Todas"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnHueMasterOn"
                            android:nextFocusRight="@id/btnHueMasterOff"
                            android:nextFocusUp="@id/btnSceneCinema"
                            android:nextFocusDown="@id/devicesContainer" />

                        <TextView
                            android:id="@+id/btnHueMasterOff"
                            style="@style/TopButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="🌑 Apagar Todas"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnHueMasterOn"
                            android:nextFocusRight="@id/btnHueLight1"
                            android:nextFocusUp="@id/btnSceneNight"
                            android:nextFocusDown="@id/devicesContainer" />

                        <TextView
                            android:id="@+id/btnHueLight1"
                            style="@style/TopButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1.2"
                            android:text="Chimenea Izq (8): ENCENDIDA"
                            android:textSize="12sp"
                            android:nextFocusLeft="@id/btnHueMasterOff"
                            android:nextFocusRight="@id/btnHueLight2"
                            android:nextFocusUp="@id/btnSceneReading"
                            android:nextFocusDown="@id/devicesContainer" />

                        <TextView
                            android:id="@+id/btnHueLight2"
                            style="@style/TopButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="0dp"
                            android:layout_weight="1.2"
                            android:text="Chimenea Dcha (10): ENCENDIDA"
                            android:textSize="12sp"
                            android:nextFocusLeft="@id/btnHueLight1"
                            android:nextFocusRight="@id/btnHueLight2"
                            android:nextFocusUp="@id/btnSceneFull"
                            android:nextFocusDown="@id/devicesContainer" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section Title for Nodes -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.06"
                    android:text="NODOS RM-OS Y DISPOSITIVOS DE RED"
                    android:textColor="#8CFFFFFF"
                    android:textSize="13sp" />

                <!-- Devices List -->
                <LinearLayout
                    android:id="@+id/devicesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
